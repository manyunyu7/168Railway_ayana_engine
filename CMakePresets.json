{
  "version": 6,
  "configurePresets": [
    { "name": "mac-debug", "generator": "Ninja", "binaryDir": "build/mac-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined", "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined" } },
    { "name": "mac-release", "generator": "Ninja", "binaryDir": "build/mac-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } }
  ],
  "buildPresets": [
    { "name": "mac-debug", "configurePreset": "mac-debug" },
    { "name": "mac-release", "configurePreset": "mac-release" }
  ]
}
